# Fix dns issues.
{
  lib,
  config,
  pkgs,
  ...
}:
with lib; let
  moduleName = "nymvpn";
in {
  environment.etc = let
    description = ''
      # This file is generated by the NymVpn Nixos plugin for compatibility with
      # any user preinstalled DNS resolver like:
      #   - a raw /etc/resolv.conf
      #   - systemd-resolved
      #   - and unbound
      #
      # It creates default files /etc/resolv.conf.d/ that points to the active resolver
    '';
  in {
    # Create a default resolv.conf containing the user defined nameservers if any.
    # When systemd-resolved or unbound stops, this files is symlinked to
    # /etc/resolv.conf and brings back default behavior (without any local DNS resolver).
    "resolv.conf.d/resolv.conf.default".text = mkDefault (
      description
      + ''
        #
        # Raw /etc/resolv.conf
        #
      ''
      + (concatMapStrings (x: "nameserver ${x}\n") config.networking.nameservers)
      ''
        options edns0 trust-ad
        search .
      ''
    );

    # Create a resolv.conf pointing to unbound.
    # When unbound starts, this file is symlinked to /etc/resolv.conf
    "resolv.conf.d/resolv.conf.unbound".text = mkDefault (
      description
      + ''
        #
        # Unbound
        #
      ''
      + ''
        nameserver ::1
        nameserver 127.0.0.1
        options edns0 trust-ad
      ''
    );
    # Create a resolv.conf pointing to systemd-resolved.
    # When systemd-resolved starts, this file is symlinked to /etc/resolv.conf
    "resolv.conf.d/resolv.conf.systemd-resolved".text = mkDefault (
      description
      + ''
        #
        # Systemd-resolved
        #
      ''
      + ''
        nameserver 127.0.0.53
        nameserver ::1
        options edns0 trust-ad
        search .
      ''
    );
  };

  ## FIX Nym: no existing dns manager error.
  # Nym can't run alongside the "unbound" dns resolver.
  # Compatible resolvers are:
  # - /etc/resolv.conf
  # - systemd-resolved
  # - reslvconf
  # - NetworkManager
  # Here we arbitrarily chose to use systemd-resolved.
  services.resolved = {
    enable = true;
    settings = {
      Resolve = {
        # ipv6 support
        DNSStubListenerExtra = "[::1]:53";
        DNSSEC = false;
        DNS = mkMerge [
          (
            mkIf (config.services.${moduleName}.lan.enable == true)
            config.services.${moduleName}.lan.nameservers
          )
        ];
        Domains = [""];
        # DNSSEC = "allow-downgrade";
        DNSOverTLS = "opportunistic";
      };
    };
  };
  # TODO: Restarts unbound when nym-vpnd / systemd-resolved service is down.
  # This stops systemd-resolved and nym-vpnd when unbound starts.

  # Add some tweaks to the default service.
  systemd.services = let
    # Recreate a default /etc/resolv.conf
    defaultResolvconf = let
      name = "systemd-resolved-resolvconf";
      config = "/run/systemd/resolve/resolv.conf";
      # config = "/etc/static/resolv.conf.d/resolv.conf.systemd-resolved";
      text = ''
        set -x
        set +e
        if [ -e "${config}" ]; then
          ${pkgs.coreutils}/bin/ln -fs ${config} /etc/resolv.conf
        fi
        exit 0
      '';
      script = pkgs.writeShellScriptBin name text;
    in "${script}/bin/${name}";
    # Recreate a compatible /etc/resolv.conf that points to systemd-resolved.
    systemdResolvedResolvconf = let
      name = "systemd-resolved-resolvconf";
      config = "/run/systemd/resolve/stub-resolv.conf";
      # config = "/etc/static/resolv.conf.d/resolv.conf.systemd-resolved";
      text = ''
        set -x
        set +e
        if [ -e "${config}" ]; then
          ${pkgs.coreutils}/bin/ln -fs ${config} /etc/resolv.conf
        # NymVPN backub
        # elif [ -e "/etc/resolv.conf.nymbackup" ]; then
        #   ${pkgs.coreutils}/bin/ln -fs /etc/resolv.conf.nymbackup /etc/resolv.conf
        fi
        exit 0
      '';
      script = pkgs.writeShellScriptBin name text;
    in "${script}/bin/${name}";

    # Recreate a compatible /etc/resolv.conf that points to unbound.
    unboundResolvconf = let
      name = "unbound-resolvconf";
      config = "/etc/resolv.conf.d/resolv.conf.unbound";
      text = ''
        set -x
        set +e
        if [ -e "${config}" ]; then
          ${pkgs.coreutils}/bin/ln -fs ${config} /etc/resolv.conf
        # NymVPN backub
        # elif [ -e "/etc/resolv.conf.nymbackup" ]; then
        #   ${pkgs.coreutils}/bin/ln -fs /etc/resolv.conf.nymbackup /etc/resolv.conf
        fi
        exit 0
      '';
      script = pkgs.writeShellScriptBin name text;
    in "${script}/bin/${name}";
  in {
    systemd-resolved = {
      after = [
        "unbound.service"
      ];
      # Stop if unbound is running.
      conflicts = with lib;
        mkMerge [
          (mkIf ((config.services.unbound.enable == true)
              && (config.services.nsd.port == 53)) ["nsd.service"])
          (mkIf
            ((config.services.unbound.enable == true)
              || (config.services.unbound.settings.server.port == "53"))
            ["unbound.service"])
          ["resolvconf.service"]
        ];
    };

    unbound = {
      before = ["systemd-resolved.service"];
      conflicts = [
        "systemd-resolved.service"
        "nym-vpnd.service"
      ];
    };

    "systemd-resolved-update-resolvconf" = {
      after = [
        "systemd-resolved.service"
        "systemd-tmpfiles-setup.service"
        "systemd-tmpfiles-resetup.service"
      ];
      requiredBy = ["systemd-resolved.service"];
      serviceConfig = {
        Type = "oneshot";
        ExecStart = systemdResolvedResolvconf;
        ExecStop = defaultResolvconf;
      };
    };
    "unbound-update-resolvconf" = {
      after = [
        "unbound.service"
        "systemd-tmpfiles-setup.service"
        "systemd-tmpfiles-resetup.service"
      ];
      requiredBy = ["unbound.service"];
      serviceConfig = {
        Type = "oneshot";
        ExecStart = unboundResolvconf;
        ExecStop = defaultResolvconf;
      };
    };
  };
}
